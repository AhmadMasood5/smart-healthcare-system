# MongoDB connection string. Change-request approval uses multi-document
# transactions, so this must point to a replica set (MongoDB Atlas works out of the box).
# Example (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smart_healthcare_spm
# Example (local single-node replica set): mongodb://127.0.0.1:27018/smart_healthcare_spm?replicaSet=rs0
MONGODB_URI=

# Optional: DNS servers Node should use. Set this if a mongodb+srv:// URI fails with
# "querySrv ECONNREFUSED" (a local DNS proxy refusing SRV lookups).
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Port for the Express API
PORT=5000

# Origin allowed by CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
